# ============================================================
# PSCVault Cloud Backend & Local Environment Variables
# ============================================================

# Server Port and Host Binding
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Atlas Database Connection URI
# Provided from your MongoDB Atlas Cluster ("mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority")
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE

# JWT Authentication Secret Key (Minimum 32 random characters for production security)
JWT_SECRET=replace_with_secure_random_secret_at_least_32_characters

# Production Frontend URL(s) for CORS Policy
# Comma-separated for multiple origins if needed
FRONTEND_URL=https://pscvault.vercel.app
